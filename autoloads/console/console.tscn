[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://autoloads/console/console.gd" id="1"]

[node name="Console" type="CanvasLayer"]
process_mode = 3
layer = 100
script = ExtResource("1")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 320.0
grow_horizontal = 2

[node name="Lines" type="VBoxContainer" parent="Panel"]
layout_mode = 2

[node name="Output" type="RichTextLabel" parent="Panel/Lines"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
scroll_following = true
selection_enabled = true

[node name="Input" type="LineEdit" parent="Panel/Lines"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Type 'help' for a list of commands"
keep_editing_on_text_submit = true

[node name="Toggle" type="Button" parent="."]
